# AinA (Ai∩A MAXX) — environment template
# Copy to .env.local and fill in real values. NEVER commit real keys.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public anon key is client-safe; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma)
DATABASE_URL=
DIRECT_URL=

# Meta Model API (server-only — never expose to the client)
MODEL_API_KEY=
META_MODEL_API_BASE_URL=
META_MODEL_TEXT_ID=muse-spark-1.3
META_MODEL_REASONING_ID=muse-wonder
META_MODEL_IMAGE_ID=muse-image
META_MODEL_SAM_ID=sam-3.1

# Gemini failover + safety screening (server-only)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# AI cost protection ($150 credit guardrails)
AI_CACHE_MODE=false
AI_REQUEST_TIMEOUT_MS=30000
AI_DAILY_USER_LIMIT=20

# Privacy
PHOTO_RETENTION_DAYS=7
